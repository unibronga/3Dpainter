{
  "name": "3dpainter",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "3DPainter — ручная покраска low-poly моделей по поверхности",
  "scripts": {
    "dev": "vite --port 5273",
    "build": "vite build",
    "preview": "vite preview --port 5273",
    "desktop": "npm run build && electron .",
    "desktop:dev": "PAINT_TOOL_DEV_URL=http://localhost:5273 electron .",
    "icon": "electron scripts/prepare-icon.cjs",
    "dist": "npm run icon && npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "three": "^0.180.0",
    "vite": "^7.1.0"
  },
  "main": "electron/main.cjs",
  "author": "Kostiantyn"
}
